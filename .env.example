# plantilla del .env de la fase 2. el .env real esta en .gitignore y no se
# sube al repositorio: copia este archivo como .env y ajusta el perfil a la
# ram de tu docker (docker info --format "{{.MemTotal}}").
#
#   ram de docker | WORKERS | WORKER_CORES | WORKER_MEMORY | DRIVER_MEMORY
#   6 GB          | 2       | 1            | 1g            | 1g
#   8 GB          | 2       | 2            | 2g            | 2g
#   16 GB         | 3       | 2            | 3g            | 3g
#   32 GB         | 4       | 3            | 6g            | 4g
#
# regla: WORKERS x WORKER_MEMORY + DRIVER_MEMORY holgadamente bajo la ram de
# docker, y SPARK_EXECUTOR_MEMORY <= SPARK_WORKER_MEMORY (o no hay executors).

COMPOSE_PROJECT_NAME=fase2-spark

# recursos del cluster
SPARK_WORKERS=2
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_DRIVER_MEMORY=2g

# jupyter: 8889 para no chocar con un jupyter nativo en el 8888
PUERTO_JUPYTER=8889
JUPYTER_TOKEN=lab-sitio3
